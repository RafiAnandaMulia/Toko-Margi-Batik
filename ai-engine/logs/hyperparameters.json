{
  "model_name": "MobileNetV2",
  "pretrained_on": "ImageNet",
  "img_size": [
    224,
    224
  ],
  "num_channels": 3,
  "epochs_phase1": 50,
  "batch_size": 32,
  "learning_rate": 0.0001,
  "optimizer": "Adam",
  "fine_tune_lr": 1e-05,
  "unfreeze_layers": 30,
  "epochs_phase2": 20,
  "dropout_rate": 0.4,
  "l2_lambda": 0.0001,
  "use_early_stop": false,
  "rotation_range": 25,
  "zoom_range": 0.2,
  "width_shift": 0.2,
  "height_shift": 0.2,
  "brightness_range": [
    0.8,
    1.2
  ],
  "horizontal_flip": true,
  "fill_mode": "nearest",
  "save_best_only": false,
  "checkpoint_mode": "weights",
  "monitor_metric": "val_accuracy"
}